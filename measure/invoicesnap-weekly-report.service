[Unit]
Description=InvoiceSnap five-line weekly web report (NIK-551)
# Linear delivery retries stop after 6 tries in a day (review, 9 Nov 2026): each try also spends
# 27 URL inspections from the shared daily quota.
StartLimitIntervalSec=86400
StartLimitBurst=6

[Service]
Type=oneshot
WorkingDirectory=%h/.cache/invoicesnap-landing
ExecStart=/bin/bash -c 'export PATH="$HOME/.npm-global/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"; source "$HOME/.config/vault/load.sh"; exec python3 measure/weekly_report.py invoicesnap --post'
TimeoutStartSec=900
Restart=on-failure
RestartSec=300
# Exit 3 = a source was unreachable; the report is already posted with unknown. Do not retry it.
RestartPreventExitStatus=3
